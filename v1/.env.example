# --- LLM / Google GenAI ---
# Provide either GEMINI_API_KEY or GOOGLE_API_KEY (GOOGLE_API_KEY wins).
GEMINI_API_KEY=
GOOGLE_API_KEY=
AGENT_MODEL=google_genai:gemini-2.5-flash

# --- Database (managed Postgres) ---
# Provide either POSTGRES_URL or DATABASE_URL.
POSTGRES_URL=
DATABASE_URL=

# --- Telegram ---
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Arbitrary shared secret; Telegram echoes it in the
# X-Telegram-Bot-Api-Secret-Token header so you can reject spoofed requests.
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS base URL of this service, e.g. https://myapp.example.com
# Used to auto-register the webhook at {WEBHOOK_BASE_URL}/api/webhook on startup.
WEBHOOK_BASE_URL=
